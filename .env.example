DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=app_educativa_recuperada

# Base pública de la aplicación, incluyendo el subdirectorio si aplica.
APP_BASE_URL=https://tudominio.com
# Genera un secreto aleatorio largo y privado; se usa para limitar solicitudes sin guardar correos/IP en claro.
APP_SECRET=replace-with-a-random-secret-of-at-least-32-characters

MAIL_FROM=cuenta-autorizada@gmail.com
MAIL_FROM_NAME=COMPORTATE
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=cuenta-autorizada@gmail.com
SMTP_PASSWORD=app-password-del-proveedor
SMTP_ENCRYPTION=tls
SMTP_TIMEOUT=15
